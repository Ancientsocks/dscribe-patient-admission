# Application
APP_NAME="DScribe Patient Admission Management"
ENVIRONMENT=development
DEBUG=true

# SQLite (default, file lives next to the backend)
DATABASE_URL=sqlite:///./dscribe.db

# PostgreSQL example (uncomment and set a real password in .env, never commit it)
# DATABASE_URL=postgresql+psycopg://dscribe:CHANGE_ME@localhost:5432/dscribe

# Comma separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma separated doctor roster shown in the dropdowns
DOCTORS="Dr. Aisha Verma,Dr. Rohan Mehta,Dr. Priya Nair,Dr. Daniel Fernandes,Dr. Sanjay Kulkarni,Dr. Kavya Reddy,Dr. Arjun Malhotra,Dr. Meera Iyer"

# Largest page size the API will return
MAX_PAGE_SIZE=100
